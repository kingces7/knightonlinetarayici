+uint16 CUser::KingCapeId()
+{
+	if (hasWhiteKingCape()) return uint16(KingCapeType::KNIGHTS_KNIG_CAPE);
+	return GetNation() == (uint8)Nation::ELMORAD ? uint16(KingCapeType::KNIGHTS_HUMAN_KING_CAPE) : uint16(KingCapeType::KNIGHTS_KARUS_KING_CAPE);
