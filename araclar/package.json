{
  "name": "knightempire-araclar",
  "private": true,
  "description": "KnightEmpire oyun dosyalarını okunabilir/düzenlenebilir biçimlere çeviren araçlar",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "tbl-coz": "node tbl/cli.ts coz",
    "tbl-yaz": "node tbl/cli.ts yaz",
    "tbl-dogrula": "node tbl/cli.ts dogrula",
    "test": "node --test",
    "paket-coz": "node paket/cli.ts coz",
    "paket-yaz": "node paket/cli.ts yaz",
    "paket-dogrula": "node paket/cli.ts dogrula",
    "harita": "node harita/cli.ts",
    "karakter": "node model/cli.ts",
    "esyalar": "node oyun/esyalar.ts && node oyun/yazitipi.ts",
    "itembox": "node oyun/itembox.ts",
    "efekt-deneme": "node oyun/efekt-deneme.ts",
    "efekt": "node oyun/efekt.ts",
    "carpisma-opd": "node harita/carpisma-opd.ts",
    "yazitipi": "node oyun/yazitipi.ts",
    "web-hazirla": "node harita/cli.ts 14th_oldmoradon && node model/cli.ts 11610 100 200 300 500 700 800 && node oyun/esyalar.ts && node oyun/yazitipi.ts",
    "arayuz": "node arayuz/cli.ts",
    "beceriler": "node oyun/beceriler.ts",
    "oyuncu": "node oyun/oyuncu.ts",
    "kontrol": "tsc --noEmit",
    "kamera": "node oyun/kamera.ts",
    "ses": "node oyun/ses.ts",
    "silahlar": "node oyun/silahlar.ts",
    "magaza": "node oyun/magaza.ts",
    "ganimet": "powershell -ExecutionPolicy Bypass -File sunucu/ganimet-disa-aktar.ps1 && node oyun/ganimet.ts",
    "gokyuzu": "node oyun/gokyuzu.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
