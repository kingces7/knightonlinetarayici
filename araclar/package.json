{
  "name": "knightempire-araclar",
  "private": true,
  "description": "KnightEmpire oyun dosyalarını okunabilir/düzenlenebilir biçimlere çeviren araçlar",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "tbl-coz": "node tbl/cli.ts coz",
    "tbl-yaz": "node tbl/cli.ts yaz",
    "tbl-dogrula": "node tbl/cli.ts dogrula",
    "test": "node --test",
    "paket-coz": "node paket/cli.ts coz",
    "paket-yaz": "node paket/cli.ts yaz",
    "paket-dogrula": "node paket/cli.ts dogrula",
    "harita": "node harita/cli.ts",
    "karakter": "node model/cli.ts",
    "esyalar": "node oyun/esyalar.ts",
    "web-hazirla": "node harita/cli.ts new_runawar && node model/cli.ts 11610 100 200 300 500 700 800 && node oyun/esyalar.ts",
    "arayuz": "node arayuz/cli.ts",
    "beceriler": "node oyun/beceriler.ts",
    "oyuncu": "node oyun/oyuncu.ts",
    "kontrol": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
